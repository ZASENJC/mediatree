<Application
    x:Class="MediaTree.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="TextControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ComboBoxItemCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="GridViewItemCheckBoxCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="ListViewItemCheckBoxCornerRadius">4</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
