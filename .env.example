# MediaTree Configuration

# Media directory path - all libraries mounted as subdirectories under /media
# Example docker volumes:
#   - /your/movies/library1:/media/库1:ro
#   - /your/movies/library2:/media/库2:ro
MEDIA_ROOT=/media

# Data persistence directory
DATA_DIR=/app/data

# JAVDB integration
JAVDB_ENABLED=true
JAVDB_SOURCE_NAME=Javdatabase
JAVDB_COOKIE=
JAVDB_CACHE_HOURS=24
JAVDB_REQUEST_INTERVAL=5

# Startup behavior
SCAN_ON_STARTUP=true
SCAN_INTERVAL_MINUTES=0

# Authentication (leave empty to disable)
AUTH_USER=
AUTH_PASS=

# Server
HOST=0.0.0.0
PORT=27580
