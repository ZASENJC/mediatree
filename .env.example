# ============================================================
# MediaTree Docker Compose 环境变量配置
# 复制此文件为 .env 并修改为你自己的配置
# cp .env.example .env
# ============================================================

# 预置管理员账号；留空时首次打开网页会引导创建管理员账号
AUTH_USER=
AUTH_PASS=

# 启动时自动扫描媒体库
SCAN_ON_STARTUP=true
# 仅用于测试容器：关闭后不加载应用内置刮削器插件
# ENABLE_BUILTIN_SCRAPER_PLUGINS=false

# TMDB 读访问令牌（可选，用于改善 TMDB 刮削）
# TMDB_ACCESS_TOKEN=

# 媒体目录（必须改成宿主机真实路径；compose 会只读挂载到 /media/${MEDIA_ALIAS}）
MEDIA_DIR=
MEDIA_ALIAS=movies

# 数据目录（用于持久化数据库、封面缓存、配置）
DATA_DIR=./data

# 宿主机端口
HOST_PORT=27580

# 监听地址：0.0.0.0 允许局域网访问；只允许本机访问可改为 127.0.0.1
BIND_ADDRESS=0.0.0.0
