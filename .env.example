# ============================================================
# MediaTree Docker Compose 环境变量配置
# 复制此文件为 .env 并修改为你自己的配置
# cp .env.example .env
# ============================================================

# 预置管理员账号；也可以留空，首次打开网页时创建管理员账号
AUTH_USER=admin
AUTH_PASS=changeme

# 启动时自动扫描媒体库
SCAN_ON_STARTUP=true
# 仅用于测试容器：关闭后不加载应用内置刮削器插件
# ENABLE_BUILTIN_SCRAPER_PLUGINS=false

# TMDB 读访问令牌（可选，用于改善 TMDB 刮削）
# TMDB_ACCESS_TOKEN=

# 媒体目录（按需配置，格式：/你的/本地/路径:/media/别名:ro）
MEDIA_VOLUMES=/path/to/your/media:/media/movies:ro

# 数据目录（用于持久化数据库、封面缓存、配置）
DATA_DIR=./data

# 宿主机端口
HOST_PORT=27580
