# ============================================================
# MediaTree Docker Compose 环境变量配置
# 复制此文件为 .env 并修改为你自己的配置
# cp .env.example .env
# ============================================================

# 认证凭据（必填）
AUTH_USER=admin
AUTH_PASS=changeme

# 刮削器配置
JAVDB_ENABLED=true
JAVDB_CACHE_HOURS=24
JAVDB_REQUEST_INTERVAL=1
SCAN_ON_STARTUP=true

# TMDB API（可选，填入后优先使用）
# TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=

# 媒体目录（按需配置，格式：/你的/本地/路径:/media/别名:ro）
MEDIA_VOLUMES=/path/to/your/media:/media/movies:ro

# 数据目录（用于持久化数据库、封面缓存、配置）
DATA_DIR=./data

# 宿主机端口
HOST_PORT=27580
