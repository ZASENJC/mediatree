# ============================================================
# MediaTree Docker Compose 环境变量配置
# 复制此文件为 .env 并修改为你自己的配置
# cp .env.example .env
# ============================================================

# 预置管理员账号；留空时首次打开网页会引导创建管理员账号
AUTH_USER=
AUTH_PASS=

# 启动时自动扫描媒体库
SCAN_ON_STARTUP=true
# 仅用于测试容器：关闭后不加载应用内置刮削器插件
# ENABLE_BUILTIN_SCRAPER_PLUGINS=false

# TMDB 读访问令牌（可选，用于改善 TMDB 刮削）
# TMDB_ACCESS_TOKEN=
